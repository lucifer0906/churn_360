{
  "annotations": {"list": []},
  "editable": false,
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "id": 1,
      "targets": [{"expr": "sum(rate(http_requests_total{handler=\"/predict\"}[1m]))", "legendFormat": "prediction requests / second", "refId": "A"}],
      "title": "Prediction Request Rate",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "id": 2,
      "targets": [{"expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{handler=\"/predict\"}[1m])) by (le))", "legendFormat": "p95 latency", "refId": "A"}],
      "title": "Prediction p95 Latency",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "percentunit"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "id": 3,
      "targets": [{"expr": "sum(rate(http_requests_total{handler=\"/predict\", status=~\"5..\"}[1m])) / clamp_min(sum(rate(http_requests_total{handler=\"/predict\"}[1m])), 1)", "legendFormat": "error rate", "refId": "A"}],
      "title": "Prediction Error Rate",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "id": 4,
      "targets": [{"expr": "churn360_feature_drift_psi", "legendFormat": "{{feature}} PSI", "refId": "A"}],
      "title": "Input Drift (PSI)",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "id": 5,
      "targets": [{"expr": "sum by (churn_label) (churn360_predictions_total)", "legendFormat": "predicted {{churn_label}}", "refId": "A"}],
      "title": "Predictions by Churn Label",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "id": 6,
      "targets": [{"expr": "churn360_feature_drift_detected", "legendFormat": "{{feature}} drift detected", "refId": "A"}],
      "title": "Drift Alert (PSI >= 0.2)",
      "type": "timeseries"
    }
  ],
  "schemaVersion": 39,
  "tags": ["churn360", "monitoring"],
  "templating": {"list": []},
  "time": {"from": "now-15m", "to": "now"},
  "title": "Churn360 API Monitoring",
  "uid": "churn360-api-monitoring",
  "version": 1
}
